: "Мрія = marzenie.", "exp_en": "Мрія = dream.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "To moje marzenie!", "tr_pl": "This is my dream!", "tr_en": "This is my dream!"}, {"q": "Подивись на їхній ____!", "options": ["гелікоптер", "крем", "причіп"], "answer": 0, "exp": "Гелікоптер = helicopter.", "exp_pl": "Гелікоптер = helikopter.", "exp_en": "Гелікоптер = helicopter.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "Popatrz na ich helikopter!", "tr_pl": "Look at their helicopter!", "tr_en": "Look at their helicopter!"}, {"q": "Вони ____!", "options": ["іржаві", "багаті", "порожні"], "answer": 1, "exp": "Багатий = rich.", "exp_pl": "Багатий = bogaty.", "exp_en": "Багатий = rich.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "Oni są bogaci!", "tr_pl": "They are rich!", "tr_en": "They are rich!"}, {"q": "Подивись на мій ____!", "options": ["логотип", "брат", "шум"], "answer": 0, "exp": "Логотип = logo.", "exp_pl": "Логотип = logo.", "exp_en": "Логотип = logo.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "Popatrz na moje logo!", "tr_pl": "Look at my logo!", "tr_en": "Look at my logo!"}, {"q": "Dinoco — спонсор Короля.", "options": ["Правда", "Неправда"], "answer": 0, "exp": "Так, синій Dinoco — команда Короля.", "exp_pl": "Tak, niebieskie Dinoco to zespół Króla.", "exp_en": "Yes, blue Dinoco is The King's team.", "tag": "Правда чи ні?", "tag_pl": "Prawda czy nie?", "tag_en": "True or false?", "tr": "Dinoco to sponsor Króla.", "tr_pl": "Dinoco is The King's sponsor.", "tr_en": "Dinoco is The King's sponsor."}, {"q": "Король каже Маккуїну: «Тобі потрібна хороша команда, малий». Що він радить?", "options": ["Купити гелікоптер", "Мати друзів і команду", "Їхати швидше"], "answer": 1, "exp": "Король — мудрий.", "exp_pl": "Król jest mądry.", "exp_en": "The King is wise.", "tag": "Сюжет", "tag_pl": "Fabuła", "tag_en": "Story", "tr": "The King: “You need a good team, kid.” What is his advice?", "tr_pl": "Król: „Potrzebujesz dobrego zespołu, mały”. Co radzi?", "tr_en": "The King: “You need a good team, kid.” What is his advice?"}, {"q": "Ти бачиш синій логотип Dinoco. Що ти кажеш Маккуїну?", "options": ["«Колись це буде твоє місце!»", "«Це іржаве»", "«Я сонний»"], "answer": 0, "exp": "Місце = place.", "exp_pl": "Місце = miejsce.", "exp_en": "Місце = place.", "tag": "Твій вибір", "tag_pl": "Twój wybór", "tag_en": "Your call", "tr": "You see the blue Dinoco logo. What do you say to McQueen?", "tr_pl": "Widzisz niebieskie logo Dinoco. Co mówisz Zygzakowi?", "tr_en": "You see the blue Dinoco logo. What do you say to McQueen?"}], "label": "СЦЕНА 2 · МРІЯ ПРО DINOCO", "label_pl": "SCENA 2 · MARZENIE O DINOCO", "label_en": "SCENE 2 · THE DINOCO DREAM", "q": "Над стадіоном летить синій гелікоптер Dinoco. Маккуїн мріє.", "q_pl": "Nad stadionem leci niebieski helikopter Dinoco. Zygzak marzy.", "q_en": "A blue Dinoco helicopter flies over the stadium. McQueen dreams.", "ins": "Встав слово, обери правду, зрозумій героя", "ins_pl": "Wstaw słowo, oceń prawdę, zrozum bohatera", "ins_en": "Fill the gap, judge true/false, read the hero", "tip": "Потрібно 70%+.", "tip_pl": "Potrzeba 70%+.", "tip_en": "You need 70%+."}, {"ref": 3}, {"type": "match", "options": ["вантажівка=truck", "причіп=trailer", "найкращий=best", "вірний=loyal", "робота=job"], "options_pl": ["вантажівка=ciężarówka", "причіп=przyczepa", "найкращий=najlepszy", "вірний=lojalny", "робота=praca"], "options_en": ["вантажівка=truck", "причіп=trailer", "найкращий=best", "вірний=loyal", "робота=job"], "label": "СЦЕНА 3 · СЛОВА", "label_pl": "SCENA 3 · SŁOWA", "label_en": "SCENE 3 · WORDS", "q": "З'єднай слова сцени з перекладом.", "q_pl": "Połącz słowa sceny z tłumaczeniem.", "q_en": "Match the scene words with their translations.", "qt_pl": "Połącz słowa sceny z tłumaczeniem.", "qt_en": "Match the scene words with their translations.", "ins": "П'ять пар зі сцени", "ins_pl": "Pięć par ze sceny", "ins_en": "Five pairs from the scene", "tip": "Повернись до словника сцени.", "tip_pl": "Wróć do słownika sceny.", "tip_en": "Go back to the scene glossary."}, {"type": "drill", "kind": "set", "items": [{"q": "Я ____, малий.", "options": ["вантажівка", "гелікоптер", "логотип"], "answer": 0, "exp": "Вантажівка = truck.", "exp_pl": "Вантажівка = ciężarówka.", "exp_en": "Вантажівка = truck.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "Jestem ciężarówką, mały.", "tr_pl": "I'm a truck, kid.", "tr_en": "I'm a truck, kid."}, {"q": "Сідай у ____!", "options": ["причіп", "крем", "місто"], "answer": 0, "exp": "Причіп = trailer.", "exp_pl": "Причіп = przyczepa.", "exp_en": "Причіп = trailer.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "Wsiadaj do przyczepy!", "tr_pl": "Get in the trailer!", "tr_en": "Get in the trailer!"}, {"q": "Ти мій ____ друг.", "options": ["іржавий", "найкращий", "порожній"], "answer": 1, "exp": "Найкращий = best.", "exp_pl": "Найкращий = najlepszy.", "exp_en": "Найкращий = best.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "Jesteś moim najlepszym przyjacielem.", "tr_pl": "You're my best friend.", "tr_en": "You're my best friend."}, {"q": "Я ____, малий.", "options": ["вірний", "смішний", "багатий"], "answer": 0, "exp": "Вірний = loyal.", "exp_pl": "Вірний = lojalny.", "exp_en": "Вірний = loyal.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "Jestem lojalny, mały.", "tr_pl": "I'm loyal, kid.", "tr_en": "I'm loyal, kid."}, {"q": "Це моя ____.", "options": ["робота", "мрія", "бригада"], "answer": 0, "exp": "Робота = job.", "exp_pl": "Робота = praca.", "exp_en": "Робота = job.", "tag": "Репліка", "tag_pl": "Kwestia", "tag_en": "Line", "tr": "To moja praca.", "tr_pl": "This is my job.", "tr_en": "This is my job."}, {"q": "Бригада механіків іде від Маккуїна.", "options": ["Правда", "Неправда"], "answer": 0, "exp": "Він грубий з командою.", "exp_pl": "Jest niegrzeczny dla zespołu.", "exp_en": "He is rude to